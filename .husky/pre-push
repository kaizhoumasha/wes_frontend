#!/bin/sh
set -e

if [ ! -d node_modules ]; then
  echo "❌ node_modules 不存在，请先运行 pnpm install"
  exit 1
fi

# Git exports repository-local variables to hooks. Clear them before tests create
# temporary repositories, then let Git rediscover this worktree from the cwd.
GIT_LOCAL_ENV_VARS=$(git rev-parse --local-env-vars)
unset $GIT_LOCAL_ENV_VARS

echo "🔍 运行推送前质量门禁..."
pnpm test
pnpm contract:test
pnpm contract:verify

CURRENT_BRANCH=$(git branch --show-current)
case "$CURRENT_BRANCH" in
  develop|main)
    ;;
  *)
    exit 0
    ;;
esac

COMMIT_SHA=$(git rev-parse HEAD)
PARENT_COUNT=$(git log -1 --pretty=%P "$COMMIT_SHA" | wc -w | tr -d ' ')
COMMIT_MSG=$(git log -1 --pretty=%B "$COMMIT_SHA")

if [ "$PARENT_COUNT" -ge 2 ]; then
  exit 0
fi

if echo "$COMMIT_MSG" | grep -qE '^Merge (branch|pull request|commit)'; then
  exit 0
fi

echo "❌ 禁止直接推送到 $CURRENT_BRANCH，请通过 Pull Request 合并"
exit 1
