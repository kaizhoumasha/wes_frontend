#!/bin/bash
# Git Pre-commit Hook: 提交前检查后端 API 能力

echo "🔍 提交前检查 API 模块..."

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# 检查是否修改了 API 模块
if git diff --cached --name-only | grep -q "src/api/modules/"; then
    echo "📦 检测到 API 模块变更"

    # 检查后端服务是否可访问
    if curl -s http://localhost:8001/api/openapi.json > /dev/null 2>&1; then
        echo "✓ 后端服务正常"

        # 检查软删除 API 是否使用了正确的创建方式
        for file in $(git diff --cached --name-only | grep "src/api/modules/"); do
            if [ -f "$file" ]; then
                if grep -q "trash\|restore" "$file" && grep -q "createCrudApi" "$file"; then
                    echo -e "${RED}❌ $file: 检测到软删除端点，但使用了 createCrudApi${NC}"
                    echo "   建议改为 createSoftDeleteCrudApi 以启用回收站功能"
                    echo ""
                    echo "   强制提交: git commit --no-verify"
                    exit 1
                fi

                # 检查是否有额外能力但未使用
                if grep -q "\.\.\.base" "$file"; then
                    module_name=$(basename "$file" .ts)
                    config_file="src/views/admin/${module_name}s/config/pageConfig.ts"
                    if [ -f "$config_file" ]; then
                        if ! grep -q "extensions" "$config_file"; then
                            echo -e "${YELLOW}⚠️  $file: API 有扩展能力，但 $config_file 未使用 extensions${NC}"
                        fi
                    fi
                fi
            fi
        done
    else
        echo -e "${YELLOW}⚠️  后端服务未启动，跳过 API 契约检查${NC}"
    fi
fi

echo -e "${GREEN}✓ 检查通过${NC}"
exit 0
